{
  "version": "v1",
  "hooks": [
    {
      "name": "Run Tests on Save",
      "description": "Runs Vitest when TypeScript files in src/ change",
      "trigger": "PostFileSave",
      "matcher": "src[\\\\/].*\\.ts$",
      "action": {
        "type": "command",
        "command": "npx vitest run"
      },
      "timeout": 300
    }
  ]
}
